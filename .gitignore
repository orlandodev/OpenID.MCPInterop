# Build results
bin/
obj/
out/

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# Rider / VS Code
.idea/
.vscode/

# Test results
[Tt]est[Rr]esult*/
*.trx

# User secrets / local config that should never be committed
**/appsettings.*.local.json
**/secrets.json

# Exported local dev cert for Keycloak to trust - machine-specific, regenerate via
# `dotnet dev-certs https -ep deploy/keycloak/certs/aspnetcore-dev-cert.pem --format Pem --no-password`
deploy/keycloak/certs/

# Machine-specific LAN IP override - generated by deploy/keycloak/setup.sh,
# see deploy/keycloak/docker-compose.override.yml.example
deploy/keycloak/docker-compose.override.yml

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# OS files
.DS_Store
Thumbs.db
