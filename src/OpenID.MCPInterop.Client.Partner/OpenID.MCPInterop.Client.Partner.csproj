<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>OpenID.MCPInterop.Client.Partner</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UserSecretsId>b1a16604-ab3d-4f0e-89f5-390d1b481ba9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package versions managed by Directory.Packages.props -->
    <!-- Microsoft.Extensions.Hosting comes transitively via Microsoft.NET.Sdk.Web -->
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenID.MCPInterop.Common\OpenID.MCPInterop.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets OpenID.MCPInterop.Tests exercise this project's internal
         helpers (ConnectFailureReporter, PartnerAuthServerSelector,
         TokenInspector) directly, the same way Server/Client keep their own
         internals narrow rather than making them public just for tests. -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OpenID.MCPInterop.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
